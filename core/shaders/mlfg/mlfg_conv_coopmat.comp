// FSR FG4 network layers on Vulkan cooperative matrices (VK_KHR_cooperative_matrix, fp16 x fp16 -> fp32, 16 x 16 x 16):
// NFRUX's "coopmat" tier of the ML runtime (core/mlfg). Same layers, constants and results as mlfg_conv.hlsl (the generic
// tier) but for the order of the fp32 sums. AMD FidelityFX SDK v2.4.0, MIT; spec tools/ffx_extract/mlfg_net.py ('amd').
// Builds: MLFG_CONV_K / MLFG_CONV_S = 3/1, 2/2, 1/1 or MLFG_CONV_T (transposed 2x2/2); MLFG_SG = the subgroup size (the group's,
// required at pipeline creation when it is not the default); MLFG_MM / MLFG_MN = the fragment shape.
// A workgroup is one subgroup and makes 16 output pixels of a row (transposed: 16 input pixels -> 32 x 2 outputs) by 64
// output channels (transposed: 32), group z; input channels 16 at a time: the 16 pixels' patch is staged in shared memory
// (fp16) and every tap's A matrix read from it with a pixel stride, the weights' B matrices from the buffer.
// Bindings as mlfg_conv.hlsl, weights fp16 [tap][ciPad16][coPad64] (t3 at c_add.z halves), biases fp32 (t6, c_x.x).
// SPDX-License-Identifier: MIT
#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = MLFG_SG) in;
layout(set = 0, binding = 0, std140) uniform Constants
{
    ivec4 c_in;   // src width, height, src0 pitch, split
    ivec4 c_in2;  // src0 first channel, src1 pitch, src1 first channel, cin
    ivec4 c_out;  // out width, height, pitch, first channel
    ivec4 c_cfg;  // cout, act, round (0 fp16, 1 fp8), write end
    ivec4 c_add;  // add pitch (0: none), add first channel, weight offset (halves), coPad
    ivec4 c_x;    // bias offset (floats), ciPad, 16-channel chunks aligned in both sources (1x1 direct loads), 8-channel staging
};
layout(set = 0, binding = 1, std430) readonly buffer Src0 { float16_t s0[]; };
layout(set = 0, binding = 2, std430) readonly buffer Src1 { float16_t s1[]; };
layout(set = 0, binding = 1, std430) readonly buffer Src0V { uvec4 s0v[]; };  // the same, 8 channels an element
layout(set = 0, binding = 2, std430) readonly buffer Src1V { uvec4 s1v[]; };
layout(set = 0, binding = 3, std430) readonly buffer Weights { float16_t wt[]; };
layout(set = 0, binding = 4, std430) readonly buffer Add { float16_t ad[]; };
layout(set = 0, binding = 5, std430) buffer Out { uint o[]; };
layout(set = 0, binding = 6, std430) readonly buffer Bias { float bias[]; };

#ifdef MLFG_CONV_T
#define TINW 16
#define TINH 1
#ifndef MLFG_NB
#define MLFG_NB 2
#endif
#define NT 4
#else
#define TINW (15 * MLFG_CONV_S + MLFG_CONV_K)
#define TINH MLFG_CONV_K
#define PAD (MLFG_CONV_K == 3 ? 1 : 0)
#ifndef MLFG_NB
#define MLFG_NB 4
#endif
#define NT 1
#endif
#define NB MLFG_NB  // 16-channel tiles a group (1: the layers with at most 16 outputs)
// The fragment shape (the device's fp16 cooperative matrix, K 16): MLFG_MM x MLFG_MN, 8 or 16 each (default 16 x 16).
#ifndef MLFG_MM
#define MLFG_MM 16
#endif
#ifndef MLFG_MN
#define MLFG_MN 16
#endif
#define SM (16 / MLFG_MM)
#define SN (16 / MLFG_MN)
#define ACC coopmat<float, gl_ScopeSubgroup, MLFG_MM, MLFG_MN, gl_MatrixUseAccumulator>
#define MA coopmat<float16_t, gl_ScopeSubgroup, MLFG_MM, 16, gl_MatrixUseA>
#define MB coopmat<float16_t, gl_ScopeSubgroup, 16, MLFG_MN, gl_MatrixUseB>
shared uvec4 sIn[TINW * TINH * 2];  // the patch, 16 channels a pixel (fp16, 8 an element)
shared float     sC[16 * 16 * NB];

// fp32 -> fp16 bits, round to nearest even (as mlfg_common.hlsli F32ToF16; a conversion instruction's rounding is not
// specified by Vulkan).
uint F32ToF16(float f)
{
    const uint u = floatBitsToUint(f), a = u & 0x7FFFFFFFu;
    if (a >= 0x38800000u && a < 0x477FF000u)  // an fp16 normal result: round on 10 mantissa bits in place (exact)
        return ((u >> 16) & 0x8000u) | ((((a + 0xFFFu + ((a >> 13) & 1u)) & 0x7FFFE000u) - 0x38000000u) >> 13);
    const uint s = (u >> 16) & 0x8000u;
    const uint e = (u >> 23) & 0xFFu;
    uint m = u & 0x7FFFFFu;
    if (e == 0xFFu) return s | 0x7C00u | (m != 0u ? 0x200u : 0u);
    const int E = int(e) - 112;
    if (E >= 31) return s | 0x7C00u;
    if (E <= 0)
    {
        if (E < -10) return s;
        m |= 0x800000u;
        const uint shift = uint(14 - E);
        uint q = m >> shift;
        const uint rem = m & ((1u << shift) - 1u), half_ = 1u << (shift - 1u);
        if (rem > half_ || (rem == half_ && (q & 1u) != 0u)) q += 1u;
        return s | q;
    }
    uint q = (uint(E) << 10) | (m >> 13);
    const uint rem = m & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (q & 1u) != 0u)) q += 1u;
    return s | q;
}
float F8Round(float x)  // as mlfg_conv.hlsl
{
    const uint u = floatBitsToUint(x);
    const uint s = u & 0x80000000u, a = u & 0x7FFFFFFFu;
    if (a >= 0x7F800000u) return uintBitsToFloat(0x7FC00000u);
    const uint e = a >> 23;
    if (e >= 121u)
    {
        uint q = a >> 20;
        const uint rem = a & 0xFFFFFu;
        if (rem > 0x80000u || (rem == 0x80000u && (q & 1u) != 0u)) q += 1u;
        const uint r = q << 20;
        return r > 0x43E00000u ? uintBitsToFloat(0x7FC00000u) : uintBitsToFloat(s | r);
    }
    if (e == 0u) return uintBitsToFloat(s);
    const uint m = (a & 0x7FFFFFu) | 0x800000u, shift = 141u - e;
    if (shift >= 26u) return uintBitsToFloat(s);
    uint q = m >> shift;
    const uint rem = m & ((1u << shift) - 1u), half_ = 1u << (shift - 1u);
    if (rem > half_ || (rem == half_ && (q & 1u) != 0u)) q += 1u;
    return uintBitsToFloat(s | floatBitsToUint(float(q) * 0.001953125));
}
float16_t LoadIn(ivec2 p, int c)
{
    if (p.x < 0 || p.y < 0 || p.x >= c_in.x || p.y >= c_in.y || c >= c_in2.w) return float16_t(0);
    const uint base = uint(p.y) * uint(c_in.x) + uint(p.x);
    if (c < c_in.w) return s0[base * uint(c_in.z) + uint(c_in2.x + c)];
    return s1[base * uint(c_in2.y) + uint(c - c_in.w + c_in2.z)];
}
float Finish(float y, int c, uint pix)
{
    if (c_add.x != 0) y += float(ad[pix * uint(c_add.x) + uint(c_add.y + c)]);
    if (c_cfg.y == 1) y = y > 0.0 ? y : y * 0.2;
    else if (c_cfg.y == 2) y = max(y, 0.0);
    return c_cfg.z == 1 ? F8Round(y) : y;
}

void main()
{
    const uint li = gl_LocalInvocationID.x;
#ifdef MLFG_CONV_T
    const ivec2 tile = ivec2(gl_WorkGroupID.xy) * ivec2(16, 1);  // input pixels
#else
    const ivec2 tile = ivec2(gl_WorkGroupID.xy) * ivec2(16, 1);  // output pixels
#endif
    const int n0 = int(gl_WorkGroupID.z) * 16 * NB;
    const int cin = c_in2.w, ciPad = c_x.y, coP = c_add.w;
#ifdef MLFG_CONV_T
    const ivec2 origin = tile;
#else
    const ivec2 origin = tile * MLFG_CONV_S - PAD;
#endif
    // The group's 16 pixels x 16 NB channels as fragments of the device's shape: MLFG_MM x MLFG_MN accumulators (K 16).
    ACC acc[NT][NB][SM][SN];
    [[unroll]] for (int t = 0; t < NT; ++t)
        [[unroll]] for (int b = 0; b < NB; ++b)
            [[unroll]] for (int i = 0; i < SM; ++i)
                [[unroll]] for (int j = 0; j < SN; ++j)
                    acc[t][b][i][j] = ACC(0.0);
#if MLFG_CONV_K == 1 && !defined(MLFG_CONV_T)
    // 1x1: the A matrices straight from the tensors when the 16 pixels are inside and the 16-channel chunks are aligned
    // (c_x.z, from the host): no staging.
    if (c_x.z != 0 && tile.x + 16 <= c_in.x)
    {
        const uint pix0 = uint(tile.y) * uint(c_in.x) + uint(tile.x);
        for (int c0 = 0; c0 < cin; c0 += 16)
        {
            MA a[SM];
            [[unroll]] for (int i = 0; i < SM; ++i)
            {
                const uint pix = pix0 + uint(MLFG_MM * i);
                if (c0 < c_in.w) coopMatLoad(a[i], s0, pix * uint(c_in.z) + uint(c_in2.x + c0), uint(c_in.z), gl_CooperativeMatrixLayoutRowMajor);
                else coopMatLoad(a[i], s1, pix * uint(c_in2.y) + uint(c0 - c_in.w + c_in2.z), uint(c_in2.y), gl_CooperativeMatrixLayoutRowMajor);
            }
            [[unroll]] for (int b = 0; b < NB; ++b)
                [[unroll]] for (int j = 0; j < SN; ++j)
                {
                    MB w;
                    coopMatLoad(w, wt, uint(c_add.z) + uint(c0 * coP + n0 + b * 16 + j * MLFG_MN), uint(coP), gl_CooperativeMatrixLayoutRowMajor);
                    [[unroll]] for (int i = 0; i < SM; ++i)
                        acc[0][b][i][j] = coopMatMulAdd(a[i], w, acc[0][b][i][j]);
                }
        }
    }
    else
#endif
    for (int c0 = 0; c0 < cin; c0 += 16)
    {
        barrier();
        // One item a pixel's 8 channels: with c_x.w (8-aligned pitches, first channels, cin and split, from the host) one
        // 16-byte load, else eight checked ones.
        for (uint i = li; i < uint(TINW * TINH * 2); i += uint(MLFG_SG))
        {
            const uint  p = i >> 1;
            const int   c = c0 + int(i & 1u) * 8;
            const ivec2 q = origin + ivec2(int(p % uint(TINW)), int(p / uint(TINW)));
            uvec4       v = uvec4(0);
            if (c_x.w != 0)
            {
                if (q.x >= 0 && q.y >= 0 && q.x < c_in.x && q.y < c_in.y && c < cin)
                {
                    const uint base = uint(q.y) * uint(c_in.x) + uint(q.x);
                    v = c < c_in.w ? s0v[(base * uint(c_in.z) + uint(c_in2.x + c)) >> 3] : s1v[(base * uint(c_in2.y) + uint(c - c_in.w + c_in2.z)) >> 3];
                }
            }
            else
                [[unroll]] for (int k = 0; k < 4; ++k)
                    v[k] = packFloat2x16(f16vec2(LoadIn(q, c + 2 * k), LoadIn(q, c + 2 * k + 1)));
            sIn[i] = v;
        }
        barrier();
#ifdef MLFG_CONV_T
        MA a[SM];
        [[unroll]] for (int i = 0; i < SM; ++i)  // in uvec4s (2 a pixel)
            coopMatLoad(a[i], sIn, uint(MLFG_MM * i * 2), 2, gl_CooperativeMatrixLayoutRowMajor);
        [[unroll]] for (int t = 0; t < 4; ++t)
            [[unroll]] for (int b = 0; b < NB; ++b)
                [[unroll]] for (int j = 0; j < SN; ++j)
                {
                    MB w;
                    coopMatLoad(w, wt, uint(c_add.z) + uint((t * ciPad + c0) * coP + n0 + b * 16 + j * MLFG_MN), uint(coP), gl_CooperativeMatrixLayoutRowMajor);
                    [[unroll]] for (int i = 0; i < SM; ++i)
                        acc[t][b][i][j] = coopMatMulAdd(a[i], w, acc[t][b][i][j]);
                }
#else
        [[unroll]] for (int t = 0; t < MLFG_CONV_K * MLFG_CONV_K; ++t)
        {
            const int ky = t / MLFG_CONV_K, kx = t % MLFG_CONV_K;
            MA a[SM];
            [[unroll]] for (int i = 0; i < SM; ++i)  // in uvec4s (2 a pixel)
                coopMatLoad(a[i], sIn, uint((ky * TINW + kx + MLFG_MM * MLFG_CONV_S * i) * 2), uint(2 * MLFG_CONV_S), gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (int b = 0; b < NB; ++b)
                [[unroll]] for (int j = 0; j < SN; ++j)
                {
                    MB w;
                    coopMatLoad(w, wt, uint(c_add.z) + uint((t * ciPad + c0) * coP + n0 + b * 16 + j * MLFG_MN), uint(coP), gl_CooperativeMatrixLayoutRowMajor);
                    [[unroll]] for (int i = 0; i < SM; ++i)
                        acc[0][b][i][j] = coopMatMulAdd(a[i], w, acc[0][b][i][j]);
                }
        }
#endif
    }
    // Epilogue: bias, add, activation, rounding; two channels a word.
    [[unroll]] for (int t = 0; t < NT; ++t)
    {
        barrier();
        [[unroll]] for (int b = 0; b < NB; ++b)
            [[unroll]] for (int i = 0; i < SM; ++i)
                [[unroll]] for (int j = 0; j < SN; ++j)
                    coopMatStore(acc[t][b][i][j], sC, uint(MLFG_MM * i * 16 * NB + b * 16 + j * MLFG_MN), uint(16 * NB), gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        for (uint i = li; i < uint(16 * 8 * NB); i += uint(MLFG_SG))
        {
            const uint px = i / uint(8 * NB), cp = (i % uint(8 * NB)) * 2u;
            const int c = n0 + int(cp);
#ifdef MLFG_CONV_T
            const ivec2 op = (tile + ivec2(int(px), 0)) * 2 + ivec2(t & 1, t >> 1);
#else
            const ivec2 op = tile + ivec2(16 * t + int(px), 0);
#endif
            if (op.x >= c_out.x || op.y >= c_out.y || c >= c_cfg.w) continue;
            const uint pix = uint(op.y) * uint(c_out.x) + uint(op.x);
            float v0 = 0.0, v1 = 0.0;
            if (c < c_cfg.x) v0 = Finish(sC[px * uint(16 * NB) + cp] + bias[c_x.x + c], c, pix);
            if (c + 1 < c_cfg.x) v1 = Finish(sC[px * uint(16 * NB) + cp + 1u] + bias[c_x.x + c + 1], c + 1, pix);
            o[(pix * uint(c_out.z) + uint(c_out.w + c)) >> 1] = F32ToF16(v0) | (F32ToF16(v1) << 16);
        }
    }
}
