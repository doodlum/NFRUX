// The DLL's version resource (CMakeLists.txt fills it in). SPDX-License-Identifier: MIT
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NFRUX"
            VALUE "FileDescription", "NFRUX frame generation"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "NFRUX"
            VALUE "ProductVersion", "@NFRUX_VERSION_STRING@"
            VALUE "LegalCopyright", "MIT; third-party notices in THIRD_PARTY.md"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
